# ============================================================
#   ShanChaStore — Biến môi trường (.env)
#   COPY file này thành .env rồi điền giá trị thật.
#   KHÔNG BAO GIỜ commit file .env (đã có trong .gitignore).
# ============================================================

# Môi trường: development | production
NODE_ENV=development

# Cổng + host
PORT=3000
HOST=127.0.0.1

# Đường dẫn database (để trống = database.db trong thư mục dự án)
DATABASE_PATH=

# Phí giao hàng mặc định (VNĐ) khi không chọn bản đồ
SHIP_FEE=15000

# Giới hạn request cho endpoint nhạy cảm (rate limiting)
RATE_LOGIN_MAX=10        # lần / 15 phút cho login/register
RATE_ORDER_MAX=20        # lần / 15 phút cho đặt hàng
RATE_REVIEW_MAX=10       # lần / 15 phút cho đánh giá
RATE_UPLOAD_MAX=20       # lần / 15 phút cho upload

# Google OAuth (bật Đăng nhập bằng Google thật khi có Client ID)
# Nếu để trống, nút Google sẽ bị TẮT an toàn (không có chế độ demo lỏng lẻo)
GOOGLE_CLIENT_ID=

# Dải IP được phép gọi CORS (phân tách bằng dấu phẩy).
# Để trống = chỉ cùng nguồn (an toàn cho localhost).
CORS_ORIGINS=